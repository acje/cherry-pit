# Build output (source .gitignore, restricted to generated directories)
target/
**/target/

# Local editor and OS state
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local agent evidence and generated knowledge graph
/.ooda/*
!/.ooda/.gitkeep
/graphify-out/
/.opencode/node_modules/

# Local credentials; examples remain visible
.env
.env.*
!.env.example
!.env.sample
.beads-credential-key

# Beads audit/runtime; preserve tracked scaffold and nested ignore policy
/.dolt/
/.beads.gate.lock
/.beads/issues.jsonl
/.beads/events.jsonl
/.beads/interactions.jsonl
/.beads/.auto-import-issues.jsonl
/.beads.backup-*

# Pending snapshot output
*.snap.new
